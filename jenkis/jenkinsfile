pipeline {
    agent any
    
    stages {
        stage('Checkout del Repository') {
            steps {
                // Sostituisci l'URL e il branch con i tuoi (se il repo è pubblico non servono credenziali)
                git branch: 'marco', url: 'https://github.com/marcofrilos/SSS26-Git.git'
            }
        }
        
        stage('Build Immagine Backend') {
            steps {
                // Il path ./es/backend dipende da come è strutturato il tuo repo. 
                // Adattalo se backend/ è nella root o dentro es/
                sh 'docker build -t banking-backend:jenkins ./bankingApp/backend'
            }
        }
        
        stage('Build Immagine Frontend') {
            steps {
                sh 'docker build -t banking-frontend:jenkins ./bankingApp/frontend'
            }
        }
    }
}